# nginx — server-specific, generated at install/update time
nginx.conf
nginx.conf.ssl
nginx.conf.bak

# Environment — NEVER commit
.env
*.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/

# Django
staticfiles/
media/
*.log
local_settings.py
db.sqlite3

# Docker volumes
mysql_data/
redis_data/

# DB backups — never commit (contains live data)
backups/
*.sql
*.sql.gz
*.dump

# Keys/certs — never commit
*.pem
*.key

# autopush script internal state (lock/flag files) — defense-in-depth;
# the lock file itself normally lives outside the repo (/run), not here.
.autopush*

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
